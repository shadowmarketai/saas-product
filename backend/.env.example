# =============================================================================
# NexaStack Backend — Environment Variables
# Copy this file to .env and fill in real values.
# =============================================================================

# ---------- Database ----------
DATABASE_URL=postgresql://nexastack:change_me_strong_password@localhost:5432/nexastack

# ---------- Auth ----------
SECRET_KEY=generate-a-random-64-char-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Razorpay (Payments) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- OpenAI ----------
OPENAI_API_KEY=

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- CORS ----------
FRONTEND_URL=http://localhost:3000

# ---------- Environment ----------
ENV=development
DEBUG=true
