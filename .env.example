# =============================================================================
# NexaStack SaaS — Environment Variables
# Copy this file to .env and fill in real values before running.
# =============================================================================

# ---------- Database ----------
DB_USER=nexastack
DB_PASSWORD=change_me_strong_password
DB_NAME=nexastack

# ---------- Application ----------
SECRET_KEY=generate-a-random-64-char-string-here
FRONTEND_URL=http://localhost

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Razorpay (Payments) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- OpenAI ----------
OPENAI_API_KEY=

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8000
